# Copy to .env and fill in. Never commit .env.
# Local mode needs none of this.

# Where state lives: duckdb (default) or snowflake
CRM_WAREHOUSE=duckdb
# Where scores go: mock (default) or salesforce
CRM_TARGET=mock
CRM_WORKDIR=demo_run

# Snowflake (live mode). Key-pair auth recommended; see snowflake/setup.sql
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=CRM_AGENT_SVC
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_ROLE=CRM_AGENT
SNOWFLAKE_WAREHOUSE=CRM_WH
SNOWFLAKE_DATABASE=CRM_SCORING
SNOWFLAKE_SCHEMA=LIFECYCLE

# Salesforce (live mode). JWT bearer via an External Client App is preferred.
SF_USERNAME=
SF_CONSUMER_KEY=
SF_PRIVATE_KEY_FILE=
# Quick start alternative for a Developer Edition org:
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_DOMAIN=login

# Optional: an LLM writes the cycle summary. The LLM never decides a promotion.
ANTHROPIC_API_KEY=
HF_TOKEN=
