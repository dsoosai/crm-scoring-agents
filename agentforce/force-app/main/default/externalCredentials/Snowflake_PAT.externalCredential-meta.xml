<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Custom</authenticationProtocol>
    <description>Snowflake programmatic access token for the AGENTFORCE_SVC service user. Paste the token into the AgentforcePrincipal principal as the authentication parameter named token.</description>
    <externalCredentialParameters>
        <parameterGroup>AgentforcePrincipal</parameterGroup>
        <parameterName>AgentforcePrincipal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>Authorization</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue>{!'Bearer ' &amp; $Credential.Snowflake_PAT.token}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>Snowflake PAT</label>
</ExternalCredential>
