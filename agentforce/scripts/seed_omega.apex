List<Case> cases = new List<Case>();
cases.add(new Case(AccountId = a.Id, ContactId = cs[2].Id, Subject = 'Warehouse queuing during month-end close', Priority = 'High', Status = 'New', Origin = 'Web', Product_Area__c = 'Performance', Description = 'Finance dashboards queue for 10 to 20 minutes on the last three business days of the month. BI_WH is a single-cluster Large warehouse.'));
cases.add(new Case(AccountId = a.Id, ContactId = cs[2].Id, Subject = 'Auto-ingest pipe lagging on events table', Priority = 'Medium', Status = 'Working', Origin = 'Web', Product_Area__c = 'Data Loading', Description = 'Product events land 40 to 60 minutes late since the bucket prefix changed.'));
cases.add(new Case(AccountId = a.Id, ContactId = cs[2].Id, Subject = 'Question about SSO group sync', Priority = 'Low', Status = 'New', Origin = 'Web', Product_Area__c = 'Security and Access', Description = 'New analysts added to the BI group in the identity provider did not get the analyst role.'));
cases.add(new Case(AccountId = a.Id, ContactId = cs[2].Id, Subject = 'Query timeout on large join', Priority = 'Medium', Status = 'Closed', Origin = 'Web', Product_Area__c = 'Performance', Description = 'Resolved by adding a clustering key and moving the job to a larger warehouse.'));
