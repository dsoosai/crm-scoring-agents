List<Contact> cs = new List<Contact>();
cs.add(new Contact(AccountId = a.Id, FirstName = 'Chris', LastName = 'Post', Title = 'VP, Revenue Operations', Email = 'chris.post@omega-inc.example', Description = 'Owns forecasting, scoring and CRM ops. Frustrated by manual lead routing.'));
cs.add(new Contact(AccountId = a.Id, FirstName = 'Priya', LastName = 'Raman', Title = 'Chief Data Officer', Email = 'priya.raman@omega-inc.example', Description = 'Executive sponsor. Wants AI in production by FY27.'));
cs.add(new Contact(AccountId = a.Id, FirstName = 'Marcus', LastName = 'Lee', Title = 'Director, Data Engineering', Email = 'marcus.lee@omega-inc.example', Description = 'Runs the platform team and the month-end pipelines.'));
cs.add(new Contact(AccountId = a.Id, FirstName = 'Alicia', LastName = 'Gomez', Title = 'ML Engineering Lead', Email = 'alicia.gomez@omega-inc.example', Description = 'Evaluating a separate ML platform for model training.'));
cs.add(new Contact(AccountId = a.Id, FirstName = 'Dana', LastName = 'Whitfield', Title = 'Senior Manager, Procurement', Email = 'dana.whitfield@omega-inc.example', Description = 'Runs the renewal process; wants budget predictability.'));
insert cs;
List<Opportunity> os = new List<Opportunity>();
os.add(new Opportunity(AccountId = a.Id, Name = 'Omega - FY27 Capacity Renewal and Expansion', StageName = 'Negotiation/Review', Amount = 540000, CloseDate = Date.newInstance(2026, 12, 15), Probability = 70, Description = 'Renewal of 60,000 credits plus expansion. Omega is on pace to exhaust FY26 capacity before term end. Procurement wants budget predictability. Competitor: the ML team is evaluating a separate ML platform for training workloads.'));
os.add(new Opportunity(AccountId = a.Id, Name = 'Omega - AI Support Copilot Production Rollout', StageName = 'Qualification', Amount = 96000, CloseDate = Date.newInstance(2026, 11, 30), Probability = 20, Description = 'Pilot live on two product lines since April. Decision on production rollout after pilot review in October.'));
os.add(new Opportunity(AccountId = a.Id, Name = 'Omega - FY26 Capacity', StageName = 'Closed Won', Amount = 360000, CloseDate = Date.newInstance(2025, 12, 20), Probability = 100, Description = 'FY26 capacity of 60,000 credits.'));
