ts.add(new Task(WhatId = a.Id, WhoId = cs[4].Id, Subject = 'Call with Dana Whitfield on renewal timeline', Status = 'Completed', ActivityDate = Date.newInstance(2026, 9, 17), Description = 'Procurement wants the renewal proposal by October 31 and a single number for FY27 capacity.'));
